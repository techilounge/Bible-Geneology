{
  "name": "bible-timeline-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "npm run derive:chronology --silent && vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check-rls": "tsx scripts/check-rls.ts",
    "db:verify": "npm run db:reset && npm run db:migrate && npm run db:check-rls",
    "test:db": "vitest run --config vitest.db.config.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "data:worksheet": "tsx scripts/figure-worksheet.ts",
    "derive:chronology": "tsx scripts/derive-chronology.ts",
    "test:coverage": "npm run derive:chronology --silent && vitest run --coverage",
    "validate:derived": "npm run derive:chronology --silent && tsx scripts/validate-derived.ts",
    "validate": "npm run validate:data && npm run validate:derived",
    "validate:prove-gate": "tsx scripts/prove-gate.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.1",
    "eslint": "^10.11.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
